{
  "info": {
    "_postman_id": "bdcd04ff-6c50-4cda-8783-c6da0ea0e925",
    "name": "Baozi Store API",
    "description": "Testes CRUD da API de clientes, produtos e pedidos. Execute as requisições na ordem para que os IDs sejam definidos automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Criar cliente",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/clientes",
        "description": "Cria o cliente usado no estudo de caso e guarda o ID retornado no ambiente.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Victor Martins Villar RU 5227284\",\n  \"clienteDesde\": \"2026-10-29\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP 201', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.environment.set('clienteId', pm.response.json().id); }"
            ]
          }
        }
      ]
    },
